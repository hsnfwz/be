---
import Base from '../layouts/Base.astro';
import { tastingMenu } from '../data/menu';
import { site } from '../data/site';

const description = `${tastingMenu.name} — a ${tastingMenu.courses.length}-course Nordic-Asian tasting menu by ${site.chef}.`;
---

<Base title={`Menu - ${site.name}`} description={description}>
  <section class="mx-10 flex flex-col items-center gap-10 text-center">
    <div class="mt-10 flex flex-col gap-5">
      <h1 class="font-serif text-3xl font-bold">Menu bé</h1>
      <p class="font-sans">Nordic-Asian cuisine by {site.chef}.</p>
    </div>

    <article class="w-full max-w-[800px] bg-white p-10 font-sans drop-shadow">
      <header class="flex flex-col gap-1 uppercase">
        <h2 class="font-bold">{tastingMenu.name}</h2>
        <p>{tastingMenu.price}</p>
      </header>

      <ol class="mt-10 flex flex-col gap-6 uppercase">
        {tastingMenu.courses.map((course) => (
          <li class="flex flex-col gap-1">
            <h3 class="font-normal">{course.name}</h3>
            {course.description && <p>{course.description}</p>}
          </li>
        ))}
      </ol>

      <footer class="mt-10 flex flex-col gap-1 border-t border-gold pt-10 uppercase">
        <h2 class="font-bold">{tastingMenu.pairing.name}</h2>
        <p>{tastingMenu.pairing.price}</p>
      </footer>
    </article>
  </section>
</Base>
