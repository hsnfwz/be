---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title={`Book - ${site.name}`} description={`Reserve a table at ${site.name}.`}>
  <section class="viewport-minus-nav flex flex-col items-center justify-center px-5">
    <h1 class="rise rule-grow rule-grow-on-load w-full max-w-[800px] text-center font-serif text-[1.5rem] leading-[1.25] font-bold md:text-[2.625rem] md:leading-[1.15]">
      Reservations Coming Soon
    </h1>
  </section>
</Base>
