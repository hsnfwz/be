---
import { site, CONTACT_IS_PLACEHOLDER } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative path to the social share image. */
  image?: string;
}

const { title, description = site.description, image = '/og.jpg' } = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site);
const imageUrl = new URL(image, Astro.site);

const structuredData: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: site.name,
  description: site.description,
  url: site.url,
  image: imageUrl.href,
  logo: new URL('/be-logo.png', Astro.site).href,
  servesCuisine: site.cuisine,
  priceRange: '$$$$',
  sameAs: [site.instagram],
  hasMenu: new URL('/menu', Astro.site).href,
  openingHours: 'Tu-Sa 18:00-23:00',
};

// Withheld while the contact details are still placeholders. See data/site.ts.
if (!CONTACT_IS_PLACEHOLDER) {
  structuredData.address = {
    '@type': 'PostalAddress',
    addressLocality: site.address.locality,
    addressCountry: site.address.country,
  };
  structuredData.telephone = site.phoneHref;
  structuredData.email = site.email;
}
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={imageUrl.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_FI" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl.href} />

<meta name="theme-color" content="#ffffff" />

<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}></script>
