---
import Wordmark from './Wordmark.astro';
---

<nav
  class="sticky top-0 z-50 flex w-full items-stretch gap-5 bg-black px-5 py-2.5 sm:gap-10 text-white"
  aria-label="Main"
>
  <Wordmark />

  {/* Wrapper so further CTAs group on the right rather than each needing ml-auto. */}
  <div class="ml-auto flex w-full max-w-[420px] min-w-0 items-center gap-5">
    <a
      href="/menu"
      class="button-fill w-full max-w-[200px] px-3 py-2 sm:px-5 text-center font-sans leading-normal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
    >
      Menu
    </a>
    <a
      href="/book"
      class="button-fill button-fill-brass w-full max-w-[200px] px-3 py-2 sm:px-5 text-center font-sans leading-normal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
    >
      Reserve
    </a>
  </div>
</nav>
