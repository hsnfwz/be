---
import Wordmark from './Wordmark.astro';
import { site, formattedAddress } from '../data/site';
---

<footer class="viewport-minus-nav mt-16 flex w-full flex-col justify-start gap-16 bg-black px-5 py-16 font-sans text-white lg:flex-row">
  <Wordmark />

  <div class="flex flex-col gap-10">
    <div class="flex flex-col gap-5">
      <h2 class="font-bold">Open</h2>
      <div class="flex flex-col gap-1">
        <p>{site.hours.time}</p>
        <p>{site.hours.days}</p>
      </div>
    </div>
    <div class="flex flex-col gap-5">
      <h2 class="font-bold">Closed</h2>
      <p>{site.hours.closed}</p>
    </div>
  </div>

  <div class="flex flex-col gap-10">
    <div class="flex flex-col gap-5">
      <h2 class="font-bold">Location</h2>
      <address class="not-italic">{formattedAddress}</address>
    </div>
    <div class="flex flex-col gap-5">
      <h2 class="font-bold">Phone</h2>
      <p>
        <a class="hover:underline focus-visible:underline" href={`tel:${site.phoneHref}`}>
          {site.phone}
        </a>
      </p>
    </div>
    <div class="flex flex-col gap-5">
      <h2 class="font-bold">Email</h2>
      <p>
        <a class="hover:underline focus-visible:underline" href={`mailto:${site.email}`}>
          {site.email}
        </a>
      </p>
    </div>
  </div>
</footer>
